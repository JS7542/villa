{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"json": {"()": "app.logging_config.JsonFormatter"}},
  "handlers": {
    "console": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout"},
    "app": {"class": "logging.handlers.RotatingFileHandler", "formatter": "json", "filename": "/var/log/villa/app.log", "maxBytes": 10485760, "backupCount": 5, "encoding": "utf-8"},
    "access": {"class": "logging.handlers.RotatingFileHandler", "formatter": "json", "filename": "/var/log/villa/access.log", "maxBytes": 10485760, "backupCount": 5, "encoding": "utf-8"},
    "error": {"class": "logging.handlers.RotatingFileHandler", "formatter": "json", "filename": "/var/log/villa/error.log", "level": "ERROR", "maxBytes": 10485760, "backupCount": 5, "encoding": "utf-8"}
  },
  "loggers": {
    "villa": {"handlers": ["console", "app", "error"], "level": "INFO", "propagate": false},
    "villa.access": {"handlers": ["console", "access"], "level": "INFO", "propagate": false},
    "uvicorn": {"handlers": ["console", "app", "error"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["console", "app", "error"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["console", "app", "error"], "level": "WARNING"}
}
