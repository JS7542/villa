# Documentation only: Spring does not automatically load .env.
# Set these in Render Environment, or export them in your shell.
SPRING_PROFILES_ACTIVE=postgres,render
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require&currentSchema=villa
DB_USERNAME=villa_app.YOUR_PROJECT_REF
DB_PASSWORD=replace-in-secret-settings
SPRING_FLYWAY_USER=villa_migrator.YOUR_PROJECT_REF
SPRING_FLYWAY_PASSWORD=replace-in-secret-settings
VILLA_MAX_GUESTS=0
BOOTSTRAP_ENABLED=false
# Only for the first launch with an EMPTY users table; remove immediately afterwards:
# BOOTSTRAP_ENABLED=true
# BOOTSTRAP_LOGIN_ID=your-admin-id
# BOOTSTRAP_PASSWORD=your-unique-12-character-or-longer-password
