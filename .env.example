# Copy to .env and choose your own passwords before starting.
MYSQL_DATABASE=villa
MYSQL_USER=villa
MYSQL_PASSWORD=replace-with-a-long-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
HTTP_PORT=80

# For Docker Hub use your namespace, e.g. JS7542's lowercase Docker Hub ID.
# Images become <IMAGE_PREFIX>/mysql, /nginx, /fastapi.
IMAGE_PREFIX=villa
IMAGE_TAG=latest

# Enable only for the initial administrator; existing users are never overwritten.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_LOGIN_ID=admin
BOOTSTRAP_PASSWORD=replace-with-an-admin-password
VILLA_MAX_GUESTS=0
# false for local HTTP; true when served over HTTPS.
COOKIE_SECURE=false
